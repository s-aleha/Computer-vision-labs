        "gray = np.array(Image.open(\"/content/download.jpg\").convert('L'))\n",
        "factors = [1, 2, 4, 8]\n",
        "plt.figure(figsize=(12, 8))\n",
        "for i, f in enumerate(factors, 1):\n",
