        "h, w = img.shape[:2]\n",
        "cy, cx = h // 2, w // 2\n",
        "crop = img[cy-100:cy+100, cx-100:cx+100]\n",
        "resized = cv2.resize(crop, (256, 256))\n",
        "gray = cv2.cvtColor(resized, cv2.COLOR_BGR2GRAY)\n",
        "Image.fromarray(gray).save(\"task4_output.jpg\")\n",
        "plt.imshow(gray, cmap='gray'); plt.axis('off'); plt.show()"
